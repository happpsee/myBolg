<!-- 头部部分 start -->
<header class="header">
  <div class="header-left">
    <a href="#">
      <h1 class="header-logo">
        <img class="header-logo--icon" src="/logo.png"></img>
        <span class="header-logo--title text-xl">代码纪事</span>
      </h1>
    </a>
  </div>
  <input class="header-search text-sm hidden-xs" placeholder="搜索文章..." />
  <div class="header-right">
    <ul class="header-list hidden-xs hidden-sm hidden-md js-head-list">
      {{#each navList}}
      <li class="header-list--item  text-base js-head-item"  data-router="{{this.navigate}}">{{this.value}}</li>
      {{/each}}
      {{#unless isLogin}}
      <li class="header-list--item  text-base header-list--log-reg-btn js-activate-form-btn">
         <a href="#" class="js-activate-form-btn-item" data-type="login">登录</a>
         <a href="#" class="js-activate-form-btn-item" data-type="registry">注册</a>
      </li>
      {{/unless}}
    </ul>
    <img src="/img/list.svg" class="header-list--icon hidden-lg" alt="选项">
  </div>

</header>
<!-- 头部部分 end -->
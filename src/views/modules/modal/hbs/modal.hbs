<div class="{{class.myModalWrap}}" id= "{{#if modalId}}{{{modalId}}}{{/if}}" hidden>
    {{#if isCustom}}
    {{{customContent}}}
    {{else}}
  <div class="{{class.myModalContain}}">
    <div class="{{class.myModalHead}}">
    {{{headTemplate}}}
        </div>
    <div class="{{class.myModalMain}}">
    {{{mainTemplate}}}
    </div>
    <div class="{{class.myModalFooter}}">
    {{{ footerTemplate}}}
    </div>
    {{/if}}
  </div>
</div>
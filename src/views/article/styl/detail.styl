@import "@/styl/variable.styl";

.article-detail--scroller {
  box-shadow-normal()
  position: relative;
  width: 1000px;
  height: 700px;
  border-radius: border_radius;
  background-color: bgc_white;
  overflow: hidden;
}

.article-detail {
  position: absolute;
  left: 0;
  top: 0;
  padding: 20px;
}
.article-head {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  row-gap: 20px;
  width: 100%;
  height: 70px;
  margin-bottom: 40px;
}
.article-about {
  display: flex;
  column-gap: 15px;
  color: input_placeholder_color;
}

.about-item-text {
  margin-left: 5px;
  color: text_color;
}

.article-detail--title {
  width: 100%;
  text-align: center;
}
.article-detail--body {
  width: 100%;
}

.submit-comment {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin: 50px 0;
}
.comment-input {
  box-shadow-normal()
  transition();
  width: 940px;
  padding: 20px;
  border: 0;
  min-height: 60px;
  overflow: hidden;
  resize none;
  border-radius: border_radius;
  background-color: bgc_white;

  &:hover {
    transform: scale(1.02);
  }
}

.submit-comment {
}

.submit-btn {
  width: 900px;
  height: 45px;
  margin-top: 10px;
  padding: 5px 0;
  border-radius: border_radius;
  background-color: #9ca3af;
}
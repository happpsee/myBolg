


:root {
  --w-e-toolbar-bg-color: #f2f3f4;
  --w-e-textarea-bg-color: #f2f3f4;
}

#editor-wrapper {
  box-shadow-normal()
  width: 1200px;
  border-radius: border_radius;
}

.w-e-bar {
  border-radius: border_radius;
}

.w-e-text-container {
  border-radius: border_radius;  
}
#toolbar-container {
}

#editor-container {
  height: 500px;
  border-radius: 8px;
}
.editor-top {
  box-shadow-normal()
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 90px;
  margin-bottom: 20px;
  padding: 10px 20px;
  border-radius: border_radius;
  background-color: bgc_white;
}


.editor-top-right {
  display: flex;
  align-items: flex-end;
  column-gap: 50px;
  cursor: pointer;
}

.editor-submit {
  transition() 
  padding: 15px 20px;
  color: text_color_stronger;
  border-radius: border_radius;
  background-color: article_tag_bgc;
 

  &:hover {
    transform: scale(1.2);
  }
}

.editor-hint {
  display: flex;
  flex-direction: column;
  color: input_placeholder_color;
}

.editor-title {
  width: 500px;
  height: 50px;
  color: text_color;
  background-color: transparent;
}
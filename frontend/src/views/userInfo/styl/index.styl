@import "@/styl/variable.styl";



input[readonly] {
  border: none
  outline: none
  &:hover,
  &:focus {
    border: none;
    outline: none;
    box-shadow: 0 0 0 #000;
    background-color: rgba(0, 0 , 0, 0.2);
  }
}

.wrap {
  box-shadow-normal();
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  height: 700px;
  padding-top: 20px;
  border-radius: border_radius;
  background-color: bgc_white; 
}

.avatar-wrap {
  position: relative;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  margin-top: 30px;
  background-color: #fff;
}

  // <div class="{{class.avatar}}">
  //   <div class="{{class.avatarTitle}}"></div>
  //   <input type="text" class="{{class.avatarInput}}">
  //   <img class="{{class.avatar}}" src="{{avatar}}"></img>
  // </div>

.avatar-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0;
}

.avatar {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  pointer-events: none;
}
.mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  pointer-events: none;
}

.avatar-title {
  margin-top: 10px;
}
.avatar-tools {
  display: flex;
  column-gap: 10px;
  padding: 10px;
  border-radius: border_radius;
  background-color: bgc_white;
  cursor:pointer;
}

.avatar-tool-item {
  &:hover {
    color:text_color_stronger ;
  }
}

.form {
  display: flex;
  flex-direction: column;
  row-gap: 20px;
  margin-top: 20px;
  padding: 20px;
}

.form-group {
  display: flex;
  column-gap: 10px;
  align-items: center;
  padding: 0 12px;
  font-weight: 500;
  border-radius: border_radius;
}
.form-input {
  box-shadow-normal();
  width: 500px;
  padding: 10px;
  border: 1px solid #e2e8f0;  
  border-radius: border_radius;
  background-color: bgc_white;
}

.btns {
  width: 100%;
  display: flex;
  justify-content: center;
  column-gap: 20px;
  margin-top: 30px;
}

.btn {
  box-shadow-normal();
  width: 120px;
  height: 60px;
  border-radius: border_radius; 
  background-color: bgc_white;
}
@import "@/styl/variable.styl";


:root {
  --w-e-toolbar-bg-color: #f2f3f4;
  --w-e-textarea-bg-color: #f2f3f4;
}
.editor-wrap {
  width: 1000px;
  height: 700px;
  padding: 20px;
}

.editor-wrapper {
  box-shadow-normal()
  width: 100%;
  border-radius: border_radius;
}

.w-e-bar {
  border-radius: border_radius;
}

.w-e-text-container {
  border-radius: border_radius;  
}
.toolbar-container {
  height: 80px;
}

.editor-container {
  height: 460px;
  border-radius: 8px;
}
.editor-top {
  box-shadow-normal()
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 90px;
  margin-bottom: 20px;
  padding: 10px 20px;
  border-radius: border_radius;
  background-color: bgc_white;
}


.editor-top-right {
  display: flex;
  align-items: flex-end;
  column-gap: 50px;
  cursor: pointer;
}

.editor-submit {
  transition() 
  padding: 15px 20px;
  color: text_color_stronger;
  border-radius: border_radius;
  background-color: article_tag_bgc;
  border: 1px solid #d9ecff;
 

  &:hover {
    transform: scale(1.2);
  }
}

.editor-hint {
  display: flex;
  flex-direction: column;
  color: input_placeholder_color;
}

.editor-title {
  width: 500px;
  height: 50px;
  color: text_color;
  background-color: transparent;
}
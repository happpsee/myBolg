<div class="{{class.editorWrap}} js-editor-wrap">
<div class="{{class.editorTop}} animate__animated animate__bounceInRight">
  <div class="{{class.editorTopLeft}}">
    <input placeholder="请输入文章标题" class="{{class.editorTitle}} js-editor-title text-2xl" spellcheck="false">
  </div>
  <div class="{{class.editorTopRight}}">
    <div class="text-base {{class.editorHint}}">
      <span>28分钟专注，1,258字沉淀</span>
    </div>
    <div class="{{class.editorSubmit}} text-base" {{{labelSign.submit}}}>发布文章</div>
  </div>
</div>
<div class="{{class.editorWrapper}} animate__animated animate__bounceInRight js-editor-wrapper">
  <div  class="{{class.toolbarContainer}} js-editor-toolbar-wrapper"><!-- 工具栏 --></div>
  <div class="{{class.editorContainer}} js-editor-content"><!-- 编辑器 --></div>
</div>
</div>
<div class="{{class.columnWrap}} js-column-wrap">
  <div class="{{class.columnPackery}}" {{{labelSign.columnList}}}>
  <p  class="{{class.addColumn}} js-add-column  text-base"  {{{labelSign.columnItem}}} {{{labelSign.addColumn}}}>
    <i class="{{class.addColumnIcon}}"></i>
    <span>新增分栏</span>
  </p>
  {{#each list}}
  {{#with this}}
  <div  class="{{../class.columnItem}} {{rowClass}} {{colClass}} text-base" {{{../labelSign.columnItem}}}>
    <p class="{{../class.columnArticleName}} js-column-article-name">{{name}}</p>
    <p class="{{../class.columnArticleNum}} js-column-article-num text-sm">文章数量: <span class="{{../class.columnArticleNumText}} text-base">{{aidLen}}</span></p>
    <p class="{{../class.columnDate}} text-sm">最近更新为: <span class="{{../class.columnDateText}} text-base">{{date}}</span></p>
  </div>
  {{/with}}
  {{/each}}
    </div>
</div>
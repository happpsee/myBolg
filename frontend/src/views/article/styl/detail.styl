.list {
  box-shadow-normal()
  position: absolute;
  top: 50px;
  right: -100px;
  display: flex;
  flex-direction: column;
  row-gap: 15px;
  width: 80px;
  padding: 20px 5px;
  background-color: bgc_white;
  border-radius: border_radius;
}
.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 5px;
  color: #ccc;
  cursor: pointer;
}
.js-comment-icon {
  width: 25px;
  height: 25px;
  background: url("/img/comment.svg");
  background-size: 25px;
}

.js-like-icon {
  width: 25px;
  height: 25px;
  background: url("/img/like.svg");
  background-size: 25px;
}

  
.js-favorite-icon {
  width: 25px;
  height: 25px;
  background: url("/img/favorite.svg");
  background-size: 25px;
  }
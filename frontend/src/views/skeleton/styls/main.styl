@import "@/styl/variable.styl";

.main {
  transition() 
  display: flex;
  justify-content: center;
  align-items: start;
  column-gap: 60px;
  margin-top: 40px;
}

.main-left {
  padding-top: 10px;
}

.main-right {
  position: relative;
  width: 1100px;
  height: 760px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden;
}
.main-right-list { 
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 45px;
  padding: 20px;
}
.main-right-article {
  box-shadow-normal()
  width: 1000px;
  display: grid;
  grid-template-columns: 1fr;
  grid-auto-flow: row;
  row-gap: 15px;
  padding: 15px 60px 15px 30px;
  border-radius: border_radius;
  background-color: bgc_white;
}












